{
  "name": "bunacircleco",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-20",
  "routes": [
    { "pattern": "bunacircleco.com", "custom_domain": true },
    { "pattern": "www.bunacircleco.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [{ "name": "INQUIRY_EMAILS", "class_name": "InquiryEmail" }]
  },
  "migrations": [{ "tag": "inquiry-email-v1", "new_sqlite_classes": ["InquiryEmail"] }],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
